# Normaliza los finales de línea: LF en el repositorio para todo el texto.
* text=auto eol=lf

# Binarios: nunca normalizar ni intentar hacer diff textual.
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.pdf  binary

# Archivos derivados de `npm run gen`: se colapsan en las revisiones porque
# la fuente real es js/products.js y el FAQ visible de index.html.
llms-full.txt          linguist-generated=true
agents.md              linguist-generated=true
index.md               linguist-generated=true
tienda.md              linguist-generated=true
hair-nails-forte.*     linguist-generated=true
radiant-skin.*         linguist-generated=true
vinagre-de-manzana.*   linguist-generated=true
sleep-vitamins.*       linguist-generated=true
sexual-booster-women.* linguist-generated=true
sexual-booster-men.*   linguist-generated=true
anti-stress.*          linguist-generated=true

# El repositorio es un sitio web, no un proyecto de JavaScript: que GitHub
# no lo clasifique por el volumen de HTML generado.
*.html linguist-detectable=true
