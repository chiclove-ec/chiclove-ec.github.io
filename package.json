{
  "name": "chiclove-ecuador",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio est\u00e1tico de Chic&Love Ecuador: cat\u00e1logo de gummies de vitaminas, checkout por WhatsApp y capa de contenido para agentes.",
  "homepage": "https://chiclove-ec.github.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chiclove-ec/chiclove-ec.github.io.git"
  },
  "bugs": {
    "url": "https://github.com/chiclove-ec/chiclove-ec.github.io/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs --target=generic",
    "build:github": "node scripts/build.mjs --target=github-pages",
    "build:netlify": "node scripts/build.mjs --target=netlify",
    "build:cloudflare": "node scripts/build.mjs --target=cloudflare",
    "build:vercel": "node scripts/build.mjs --target=vercel",
    "gen": "npm run gen:products && npm run gen:jsonld",
    "gen:products": "node scripts/gen-products.mjs",
    "gen:jsonld": "node scripts/gen-jsonld.mjs",
    "set-origin": "node scripts/set-origin.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "npm run build:github && npm test"
  },
  "engines": {
    "node": ">=20"
  }
}
